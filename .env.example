# Checkout externo (Kiwify ou Hotmart) — URL da página de compra
NEXT_PUBLIC_CHECKOUT_URL=https://pay.kiwify.com.br/SEU_PRODUTO_ID

# WhatsApp para captura de leads
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999
NEXT_PUBLIC_WHATSAPP_MESSAGE=Olá! Tenho interesse no programa Gerando Milagres da Dra. Camilla Freitas 🌸

# Resend — entrega de leads por email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@gerandomilagres.com.br
RESEND_TO_EMAIL=camilla@gerandomilagres.com.br

# Analytics (opcional — ativados somente com consentimento LGPD)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Meta Conversions API — SOMENTE servidor (nunca NEXT_PUBLIC_)
META_CONVERSIONS_TOKEN=

# Webhook Kiwify → Purchase (Funil 01). Desligado até existir contrato oficial
# de payload/assinatura. Não ativar junto com o Pixel/CAPI nativo da Kiwify.
KIWIFY_WEBHOOK_ENABLED=false
KIWIFY_WEBHOOK_TOKEN=
